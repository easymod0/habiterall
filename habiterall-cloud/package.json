{
  "name": "habiterall-cloud",
  "version": "0.1.0",
  "description": "Multi-user, self-hosted habit tracker with per-user data isolation",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "test": "node --test test/*.test.js",
    "test:tenancy": "node test/tenancy.integration.mjs",
    "test:api": "node test/api.integration.mjs",
    "test:healthz": "node test/healthz.integration.mjs",
    "test:claims": "node test/login-claims.integration.mjs",
    "test:notify": "node test/notify.integration.mjs",
    "test:ntfyanswer": "node test/ntfy-answer.integration.mjs",
    "test:roundtrip": "node test/roundtrip.integration.mjs"
  },
  "dependencies": {
    "express": "^5.2.1",
    "pg": "^8.13.1",
    "openid-client": "^6.8.7",
    "express-session": "^1.18.1",
    "connect-pg-simple": "^10.0.0",
    "helmet": "^8.0.0",
    "express-rate-limit": "^8.6.2"
  },
  "license": "GPL-3.0-or-later"
}

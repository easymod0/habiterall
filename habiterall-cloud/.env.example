# Copy to .env and fill in. Generate each secret with:
#   openssl rand -base64 36
#
# EXCEPT the two database passwords, which are substituted into a connection
# URL: use `openssl rand -hex 32` for those. base64 emits '/', which ends the
# URL's authority and leaves the app with no host to connect to.
#
# .env is gitignored — never commit real secrets.

# ---- database -------------------------------------------------------------
DB_OWNER_PASSWORD=CHANGE_ME_owner
APP_DB_PASSWORD=CHANGE_ME_app
AUTHENTIK_DB_PASSWORD=CHANGE_ME_authentik

# ---- application ----------------------------------------------------------
SESSION_SECRET=CHANGE_ME_session_secret_at_least_32_bytes

# The externally reachable URL of habiterall-cloud. MUST match the redirect
# URI registered in Authentik, and MUST be https in production (the session
# cookie is Secure).
PUBLIC_URL=http://localhost:3100

APP_PORT=3100
AUTHENTIK_PORT=9000

# Number of reverse proxies in front of the app, for correct client IPs.
# Set to 0 if nothing proxies it.
TRUST_PROXY=1

# ---- identity provider ----------------------------------------------------
# The OIDC application is created for you: compose runs
# scripts/bootstrap-authentik.mjs on every `up`, and it CONFIGURES the
# provider with the id and secret below rather than handing you a generated
# pair to paste back. Generate them like any other secret (hex — they travel
# in URLs and headers):
#
#   openssl rand -hex 32
#
# These two cannot be left empty: compose interpolates the whole file before
# it starts anything, so an empty value stops `docker compose up` rather than
# reaching the bootstrap. And unlike the other CHANGE_ME lines here, these are
# WRITTEN TO the identity provider — a placeholder from a public repository
# would become a real client secret, so the bootstrap refuses one.
OIDC_CLIENT_ID=CHANGE_ME_oidc_client_id
OIDC_CLIENT_SECRET=CHANGE_ME_oidc_client_secret

# The issuer is Authentik's URL as the BROWSER sees it, plus the application
# slug, ending in a slash. It must be byte-identical for the browser and for
# the app container or token validation fails.
OIDC_ISSUER=http://localhost:9000/application/o/habiterall/
# Same URL without the application path. Only the bootstrap reads it, to
# report the issuer it configured and to warn when the two disagree.
AUTHENTIK_PUBLIC_URL=http://localhost:9000

# ---- self-service registration -------------------------------------------
# `on` puts a "Sign up" link on the Authentik login page, and anyone who can
# reach it can create an account — on a public instance, that is the whole
# internet. `off` (the default) removes the link AND the flow behind it, so
# accounts exist only where you create them in Directory -> Users.
#
# Read this if your Authentik serves anything besides habiterall: the link
# goes on the DEFAULT login flow, which is the one every application on that
# instance uses. What a stranger creates is an Authentik account, not a
# habiterall one — it just happens to reach habiterall, because habiterall
# admits anyone who signs in. Any other application that admits "any
# authenticated user" would admit them too. Give the enrolled users a group
# and bind a policy to your other applications, or keep this off and create
# accounts yourself.
#
# Accepted: on/true/yes/1/enabled and off/false/no/0/disabled (and empty for
# off). Anything else stops the stack rather than being guessed at, because
# the guess that matters would be reading a typo as "let the world in".
AUTHENTIK_SELF_SIGNUP=off

# Require the address to be confirmed before the account works. The user is
# created inactive and the link in the mail is what activates it — so it needs
# a real SMTP server below, or sign-ups stall unconfirmed.
AUTHENTIK_SELF_SIGNUP_VERIFY_EMAIL=off

# ---- branding -------------------------------------------------------------
# The sign-in and sign-up pages carry habiterall's name, mark and colours
# instead of Authentik's. The admin interface is left alone.
#
# `off` stops these being managed; it does not restore Authentik's own
# branding, which is a thing to change back in the admin UI if you want it.
#
# The two images are served by Authentik itself, from directories compose
# mounts into its containers (`../shared/public/icons` and `./branding`) —
# replace either file and the next request has it. The app cannot serve them:
# it answers static requests with `Cross-Origin-Resource-Policy: same-origin`,
# and the login page is another origin.
#
# The page titles and the sign-in colours are scoped to those pages; the tab
# title, the favicon and the accent colour also reach Authentik's own admin
# and user interfaces, which is cosmetic and mentioned so it is not a surprise.
AUTHENTIK_BRANDING=on

# ---- outgoing mail --------------------------------------------------------
# Authentik's own setting names. Nothing here sends mail except the
# verification above, so these can stay as they are until you turn it on.
#
# Submission port and STARTTLS by default, deliberately: the minimal edit is
# to fill in the host and the credentials below, and on port 25 with TLS off
# that edit puts an SMTP password and an account-activation link on the wire
# in the clear. Only lower it for a relay on the same host.
AUTHENTIK_EMAIL__HOST=localhost
AUTHENTIK_EMAIL__PORT=587
AUTHENTIK_EMAIL__USERNAME=
AUTHENTIK_EMAIL__PASSWORD=
AUTHENTIK_EMAIL__USE_TLS=true
AUTHENTIK_EMAIL__USE_SSL=false
AUTHENTIK_EMAIL__FROM=habiterall@example.com

# ---- authentik bootstrap --------------------------------------------------
# The password and email create the first admin account and are then dead
# weight. The TOKEN is different: it is what lets compose keep the OIDC
# application and the registration switch above in step with this file, on
# every `up`. Delete it and both freeze as they were — which is a supported
# way to run (the bootstrap then does nothing and says so), but flipping a
# switch here would stop having any effect.
AUTHENTIK_SECRET_KEY=CHANGE_ME_authentik_secret_key
AUTHENTIK_BOOTSTRAP_PASSWORD=CHANGE_ME_initial_admin_password
AUTHENTIK_BOOTSTRAP_EMAIL=admin@example.com
AUTHENTIK_BOOTSTRAP_TOKEN=CHANGE_ME_api_token_for_setup

# ---- limits ---------------------------------------------------------------
MAX_HABITS_PER_USER=200
MAX_ENTRIES_PER_IMPORT=200000
MAX_UPLOAD_MB=16

# ---- reminders ------------------------------------------------------------
# Reminders a user has pointed at a Discord webhook are sent by this process,
# once a minute. Users with only the on-device destination cost nothing here:
# the phone arms its own alarms and the scan skips them.
#
# `off` disables the loop entirely. The embed links back to PUBLIC_URL.
HABITERALL_NOTIFY=on
HABITERALL_NOTIFY_INTERVAL_MS=60000
# Accounts visited per tick. A tick is a minute and each account may cost a
# webhook round trip, so this bounds the work rather than letting one pass
# overlap the next.
NOTIFY_MAX_ACCOUNTS=500

# Interactive Discord reminders — Yes / No / Skip buttons and an amount box.
#
# One bot for the whole instance; each user pastes their own channel id into
# Settings. Deliberately NOT a per-user setting: this token can post to every
# channel the bot is in, so it is yours, not theirs, and GET /api/settings hands
# user settings to the browser.
#
# Create it at https://discord.com/developers/applications → Bot → Reset Token,
# then invite the bot with the `bot` scope and Send Messages.
#
# With it set the app opens ONE outbound WebSocket to Discord to receive button
# presses. No inbound port and no public hostname are needed for that.
# Leave it empty and Discord reminders fall back to webhook text.
DISCORD_BOT_TOKEN=

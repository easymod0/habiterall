# Copy to .env and fill in. Generate each secret with:
#   openssl rand -base64 36
#
# .env is gitignored — never commit real secrets.

# ---- database -------------------------------------------------------------
DB_OWNER_PASSWORD=CHANGE_ME_owner
APP_DB_PASSWORD=CHANGE_ME_app
AUTHENTIK_DB_PASSWORD=CHANGE_ME_authentik

# ---- application ----------------------------------------------------------
SESSION_SECRET=CHANGE_ME_session_secret_at_least_32_bytes

# The externally reachable URL of habiterall-cloud. MUST match the redirect
# URI registered in Authentik, and MUST be https in production (the session
# cookie is Secure).
PUBLIC_URL=http://localhost:3100

APP_PORT=3100
AUTHENTIK_PORT=9000

# Number of reverse proxies in front of the app, for correct client IPs.
# Set to 0 if nothing proxies it.
TRUST_PROXY=1

# ---- identity provider ----------------------------------------------------
# Filled in after creating the OIDC application in Authentik (see SETUP.md).
# The issuer is shown on the application's provider page and ends with a slash.
OIDC_ISSUER=http://localhost:9000/application/o/habiterall/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# ---- authentik first-run bootstrap ---------------------------------------
# Used only until the initial admin account exists.
AUTHENTIK_SECRET_KEY=CHANGE_ME_authentik_secret_key
AUTHENTIK_BOOTSTRAP_PASSWORD=CHANGE_ME_initial_admin_password
AUTHENTIK_BOOTSTRAP_EMAIL=admin@example.com
AUTHENTIK_BOOTSTRAP_TOKEN=CHANGE_ME_api_token_for_setup

# ---- limits ---------------------------------------------------------------
MAX_HABITS_PER_USER=200
MAX_ENTRIES_PER_IMPORT=200000
MAX_UPLOAD_MB=16

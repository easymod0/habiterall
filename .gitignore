# This is one repository containing three npm workspaces, so the ignore rules
# live here rather than being scattered per package. npm hoists dependencies
# to the ROOT node_modules, which per-package ignore files would miss entirely.

# ---- dependencies ----
node_modules/

# ---- secrets ----
# habiterall-cloud/.env holds live database passwords, the session secret, and
# the OIDC client secret. Never commit it; .env.example is the template.
.env
.env.*
!.env.example

# ---- local data ----
# The personal edition's SQLite directory. ANCHORED with a leading slash on
# purpose: a bare `data/` matches at any depth, and it silently excluded
# android-native/app/src/main/java/com/habiterall/app/data/ — four Kotlin source
# files, so the app could not compile from a fresh clone and CI had never built
# it. Keep new entries anchored unless they really are meant to match anywhere.
/habiterall-personal/data/
*.db
*.db-journal
*.db-wal
*.db-shm

# ---- android ----
# Generated per-deployment from YOUR signing key; committing a placeholder
# would silently break TWA verification (the app shows a URL bar).
shared/public/.well-known/assetlinks.json

# ---- android signing ----
# A leaked keystore lets anyone publish an update to your app.
*.keystore
*.jks
android/app/
android/build/
android/.gradle/
android/local.properties

# ---- android-native (the Kotlin client) ----
# Gradle output and caches.
android-native/.gradle/
android-native/build/
android-native/app/build/
android-native/captures/

# Absolute path to YOUR Android SDK. Generated by the IDE or by hand; it is
# machine-specific and breaks every other checkout if committed.
android-native/local.properties

# The wrapper jar is a binary nobody can review in a diff, so CI regenerates
# it from the version pinned in gradle-wrapper.properties. That properties
# file IS committed — it is what pins the version.
android-native/gradle/wrapper/gradle-wrapper.jar
android-native/gradlew
android-native/gradlew.bat

# ---- build artifacts ----
# Locally built APKs. Releases are published as GitHub release assets, not
# committed — a 17 MB binary per build would bloat the repository fast.
dist/
*.apk
*.aab

# ---- build / tooling noise ----
*.log
npm-debug.log*
.DS_Store
Thumbs.db
coverage/
.idea/
.vscode/

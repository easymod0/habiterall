<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- API 33+: notifications are opt-in, requested at runtime. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      A reminder that drifts by an hour is not a reminder.

      BOTH exact-alarm permissions, split at the version where the second one
      begins to exist. USE_EXACT_ALARM is protection level `normal` — granted at
      install, not revocable, and it makes `canScheduleExactAlarms()` return true
      unconditionally — so from API 33 up every reminder takes the exact branch
      with no prompt and no trip into system Settings. Below 33 it does not
      exist, and SCHEDULE_EXACT_ALARM carries 31-32, where it is granted by
      default and user-revocable. Below 31 no permission is needed at all.

      This REVERSES the earlier "SCHEDULE_EXACT_ALARM only, deliberately not
      USE_EXACT_ALARM". That shape declared a permission it never REQUESTED —
      ACTION_REQUEST_SCHEDULE_EXACT_ALARM appears nowhere in this client — and an
      app targeting 33+ is denied that one by default on Android 14, so
      `canScheduleExactAlarms()` was false forever and every reminder rode
      `setAndAllowWhileIdle`. That reads as flakiness rather than as a missing
      permission, because the drift grows with how long the app has gone
      unopened: a reminder set from the app looks punctual, and the same one set
      from a browser and left overnight looks like it never fired.

      The Play restriction the old comment cited does not reach this client. The
      APK is sideloaded from a GitHub release (release.yml), there is no review
      to fail, and Loop — a habit tracker — ships USE_EXACT_ALARM on Play anyway.

      The inexact fallback in `Reminders.setAlarm` is NOT dead code, which was
      the old comment's other objection. It stays reachable on 31-32 for a user
      who has revoked "Alarms & reminders", and `setAlarm` re-reads the
      permission on every arm — so a grant or a revocation needs no migration.
    -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <!-- Alarms do not survive a reboot; the receiver re-arms them. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".HabiterallApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Habiterall">

        <!--
          singleTop, because a notification tap has to land on the app that is
          already running rather than build a second one on top of it: the
          list, its scroll position and anything half-typed are all held by
          that instance, and the tap arrives as onNewIntent instead.
        -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Habiterall">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Prompts for a number when a measurable habit's notification is tapped.
          Transparent and excluded from recents so it feels like part of the
          shade rather than a detour into the app.
        -->
        <!--
          `taskAffinity=""` puts it in a task of its OWN, and that is not
          cosmetic: it is launched with NEW_TASK|CLEAR_TASK, and while it shared
          MainActivity's affinity those flags finished every activity in the
          app's task — so answering a measurable habit from the shade, or from
          the home-screen widget, silently threw away the running app, its
          scroll position and anything half-typed, leaving a cold start behind.
          With `noHistory` the task then emptied and vanished too.
        -->
        <activity
            android:name=".ui.CountEntryActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Habiterall.Transparent" />

        <!-- Handles Yes / No / Skip taps without bringing the app forward. -->
        <receiver
            android:name=".notify.ActionReceiver"
            android:exported="false" />

        <!-- Fires at a habit's reminder time and posts the notification. -->
        <receiver
            android:name=".notify.ReminderReceiver"
            android:exported="false" />

        <!--
          One habit on the home screen, today, tap to record.

          The two clock actions stand in for part of the `onResume` a widget
          does not have: the record says which day it is about, so a redraw is
          all it takes to stop showing yesterday's answer.

          `DATE_CHANGED` is deliberately NOT here, though it is the one that
          sounds right. It is not on Android's implicit-broadcast exception
          list, so a manifest-registered receiver is never sent it on any
          version this app supports — the trigger aimed at midnight has to be
          an alarm, and `HabitWidget.armMidnight` is it. TIME_SET and
          TIMEZONE_CHANGED *are* on the list, which is exactly why the wrong
          version of this passes every test you can run from a shell.
        -->
        <receiver
            android:name=".widget.HabitWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/habit_widget_info" />
        </receiver>

        <!--
          Asks which habit a newly-placed widget is for. Exported, because the
          launcher starts it: that is what a configuration activity is, and
          the only thing it can be told is a widget id the launcher just made.
        -->
        <activity
            android:name=".widget.WidgetConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Habiterall.Transparent">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".notify.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- Some OEMs send this instead after an app update. -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <!-- Exact alarms can be revoked and re-granted at runtime. -->
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>

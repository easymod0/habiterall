<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">habiterall</string>

    <string name="channel_reminders">Habit reminders</string>
    <string name="channel_reminders_desc">
        A reminder at the time you set for each habit, with buttons to record
        the day without opening the app.
    </string>

    <string name="reminder_boolean">Did you do it today?</string>
    <string name="reminder_avoid">Did you stay clear of it today?</string>
    <!-- %1$s is the target, e.g. "8 glasses". -->
    <string name="reminder_measurable">Target: %1$s</string>

    <string name="action_yes">Yes</string>
    <string name="action_no">No</string>
    <!-- The same two buttons on a habit shown as something to avoid. "Yes" on
         "did you smoke?" records the opposite of what it looks like. -->
    <string name="action_clean">Clean</string>
    <string name="action_slipped">Slipped</string>
    <string name="action_skip">Skip</string>
    <string name="action_enter_count">Enter count</string>
    <!-- Says the duration rather than "Snooze", because there is only one and
         the button is the only place it is written down. -->
    <string name="action_snooze">In 1 hour</string>

    <string name="recorded_yes">Recorded</string>
    <string name="recorded_no">Marked not done</string>
    <string name="recorded_clean">Marked clean</string>
    <string name="recorded_slipped">Marked as a slip</string>
    <string name="recorded_skip">Skipped</string>
    <string name="snoozed">Asking again in an hour</string>
    <!-- A snooze is never re-dated onto another day, so there is none to give
         either late in the evening or on a notification left over from
         yesterday. One sentence covers both: the day's own reminder is
         untouched either way. -->
    <string name="snooze_too_late">Too late to snooze that day</string>
    <string name="invalid_amount">Enter a number of zero or more</string>

    <!-- The home-screen widget. -->
    <string name="widget_description">One habit, today. Tap to record it.</string>
    <string name="widget_pick_habit">Which habit?</string>
    <string name="widget_needs_server">Open habiterall and set your server first</string>
    <string name="widget_needs_network">Could not reach the server. A widget has to be told which habit it is for.</string>
    <string name="widget_no_habits">No habits yet</string>
    <!-- Spoken, never drawn: the cell itself is a colour and a mark. -->
    <string name="widget_done">done today</string>
    <string name="widget_not_done">not done today</string>
    <string name="widget_clean">clean today</string>
    <string name="widget_slipped">slipped today</string>
    <string name="widget_skipped">skipped today</string>
    <string name="widget_unanswered">not answered yet</string>
    <!-- %1$s is the habit's name. Spoken when the habit has been deleted or
         archived: the widget stops recording and opens the app instead. -->
    <string name="widget_gone">%1$s is no longer on this account</string>
    <!-- The same thing, drawn: a 2x2 cell has room for one short line. -->
    <string name="widget_gone_short">Removed</string>

    <!-- The per-habit stats widget: score, streak and a seven-day strip, all
         cached answers from `/api/overview` and never recomputed here. -->
    <string name="stats_widget_description">A habit\'s score, streak and recent days, at a glance.</string>
    <!-- %1$s is the date the figures are as of, e.g. "2026-08-15" — visible,
         not only spoken, so a stale widget never looks pixel-identical to a
         current one (docs/decisions/android.md: the first version of that
         line was content-description only). -->
    <string name="stats_stale">As of %1$s</string>
    <!-- `record.date` is the day the ENTRY is about, not when the score and
         streak were last fetched: a local answer or a refused write can move
         the strip with no network at all, which is what `figuresStale`
         (`Widgets.Record`) tracks. Shown instead of `stats_stale` when the
         record's own day IS today and only the figures are behind, so the
         line does not name a date nothing is wrong with. -->
    <string name="stats_figures_behind">Score updates on next sync</string>
    <!-- Spoken for `stats_root`, current record only (`widget_gone` covers a
         gone one). %1$s the habit's name, %2$d the score as a whole percent
         (already clamped to 0..100), %3$d the current streak. -->
    <string name="stats_summary">%1$s: %2$d%% score, streak %3$d</string>
    <!-- Spoken for `stats_root` in place of `stats_summary` when
         `record.date != today` — the same mistake `stats_stale`/`stats_note`
         were added to fix, one layer up: a record days old was announced,
         unqualified, as current, because the content description branched on
         `gone` alone. %1$s the habit's name, %2$d the score, %3$d the current
         streak, %4$s the day the figures are as of (`record.date`), the same
         day `stats_stale`'s visible note line names. Positional args, never
         string concatenation — `stats_summary`'s own comment says why. -->
    <string name="stats_summary_stale">%1$s: %2$d%% score, streak %3$d, as of %4$s</string>
    <!-- Spoken for `stats_root` in place of `stats_summary` when the record's
         day IS today but `figuresStale` is set — the same "updates on next
         sync" sense `stats_figures_behind`'s visible note line uses, said
         instead of naming a date nothing is wrong with. %1$s the habit's
         name, %2$d the score, %3$d the current streak. -->
    <string name="stats_summary_figures_behind">%1$s: %2$d%% score, streak %3$d, score updates on next sync</string>
    <!-- One strip cell, `state == UNKNOWN && habit.unloggedIsSuccess` — the
         day the strip paints with the ghost-kept fill (`HabitWidget.stripFill`)
         because this habit's rule already counts an unanswered day as kept.
         `HabitWidget.describe` still answers `widget_unanswered` for UNKNOWN
         and is left alone (its own glyph/description disagreement on the big
         cell is pre-existing and not this PR's to change); this string is
         `StatsWidget.render`'s own per-cell case, so the same day does not
         paint kept and announce itself unanswered. -->
    <string name="stats_cell_kept">kept, nothing logged</string>

    <string name="count_hint">Amount</string>
    <string name="save">Save</string>
    <string name="cancel">Cancel</string>
</resources>

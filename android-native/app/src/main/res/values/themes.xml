<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The Compose UI supplies its own colours, so the platform theme only has
      to provide a sane window background and follow the system's day/night
      setting.

      DeviceDefault.DayNight would do both, but it only exists from API 29 and
      minSdk here is 26 — on Android 8 and 9 that resolves to nothing and the
      activity fails to inflate. The plain DeviceDefault base works everywhere;
      values-v29/ overrides it with the DayNight variant where it exists.
    -->
    <!--
      NoActionBar, because the Compose UI draws its own TopAppBar. With the
      ActionBar variant the window has two title bars, and the platform one
      overlaid the content: the first habit's name sat behind it, so the list
      looked sliced off at the top. It survived a "scroll position" fix because
      it was never the scroll position.
    -->
    <style name="Theme.Habiterall" parent="@android:style/Theme.DeviceDefault">
        <!--
          The Compose UI draws its own TopAppBar, so the window must not also
          have a platform one. Set as attributes rather than by inheriting a
          .NoActionBar parent: the composite
          `Theme.DeviceDefault.DayNight.NoActionBar` does not exist as a
          platform style, and only aapt tells you so.
        -->
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!--
      Used by CountEntryActivity, which is only ever a dialog over whatever is
      already on screen. A transparent, un-animated window keeps it feeling
      like part of the notification shade rather than a launch into the app.
    -->
    <style name="Theme.Habiterall.Transparent" parent="@android:style/Theme.DeviceDefault.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>
</resources>

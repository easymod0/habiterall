<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon foreground. The 108dp canvas is deliberately larger than what
  is guaranteed visible: launchers mask it to their own shape and may crop to
  the inner 72dp, so the checkmark is kept well inside that safe zone.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Stroked rather than filled, so the weight matches the web icon's
         chunky checkmark instead of reading as a thin tick. -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="11"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M33,55 L46,68 L75,39" />
</vector>

{
  // Browser-side code: DOM globals, no Node ones. Absolute specifiers like
  // '/shared/app.js' are HTTP paths the server maps at runtime, so they are
  // pointed at the real files here via `paths`.
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "types": [],

    "allowJs": true,
    "checkJs": true,
    "noEmit": true,

    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,

    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    "paths": {
      "/shared/*": ["./shared/public/*"]
    }
  },
  "include": [
    "shared/public/**/*.js",
    "habiterall-personal/public/**/*.js",
    "habiterall-cloud/public/**/*.js",

    // habiterall.ca's one script: the theme control and wiki search. The
    // generator that emits the pages around it is Node code and is in
    // tsconfig.json.
    "site/static/*.js"
  ],
  "exclude": ["node_modules", "**/node_modules"]
}
